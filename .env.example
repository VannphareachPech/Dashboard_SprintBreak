# Environment variables for pulse-dashboard
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real URLs.

# Apps Script web app deployment URL
# Found in: Apps Script → Deploy → Manage Deployments → Web App URL
APPS_SCRIPT_URL=

# Shared-secret token for Apps Script auth (C1 security fix).
# 1. Generate a strong random string, e.g.: openssl rand -hex 32
# 2. Paste it here AND add it to Apps Script Script Properties as DASHBOARD_API_TOKEN.
# Leave empty to bypass auth (only safe for private/org-restricted deployments).
APPS_SCRIPT_TOKEN=

# Gemini AI API key (for /api/gemini-insights)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
