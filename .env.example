# Environment variables for pulse-dashboard
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real URLs.

# Apps Script web app deployment URL
# Found in: Apps Script → Deploy → Manage Deployments → Web App URL
APPS_SCRIPT_URL=

# Shared secret required by the Apps Script web app (doGet/doPost).
# Set the SAME value in Apps Script → Project Settings → Script Properties → API_SHARED_SECRET.
# Generate any long random string (e.g. `openssl rand -hex 32`).
APPS_SCRIPT_SECRET=
